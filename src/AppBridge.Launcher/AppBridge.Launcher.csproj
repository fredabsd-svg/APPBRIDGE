<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AppBridge.Launcher</RootNamespace>
    <AssemblyName>AppBridge.Launcher</AssemblyName>
    <Version>0.0.1-alpha</Version>
    <UseWindowsAppSdk>true</UseWindowsAppSdk>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.AppSDK" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.AppRuntime" Version="1.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="CommunityToolkit.WinUI" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

</Project>
