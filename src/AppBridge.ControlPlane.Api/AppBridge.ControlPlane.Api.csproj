<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Pinned above the transitive default (2.0.0) to close GHSA-v5pm-xwqc-g5wc (PS-06).
         Staying on the 2.x line: 3.x is a breaking change incompatible with the OpenApi
         source generator that ships with Microsoft.AspNetCore.OpenApi 10.0.10. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>

</Project>
